generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(REP)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  repLinks      RepLink[]
  contactStates RepContactState[]
  savedSearches SavedSearch[]
}

enum UserRole {
  ADMIN
  REP
}

// Rep to GHL mapping
model RepLink {
  id            String   @id @default(cuid())
  userId        String
  ghlLocationId String
  ghlUserId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ghlLocationId])
  @@index([ghlUserId])
}

// Synced contacts from GHL
model Contact {
  id              String    @id @default(cuid())
  ghlContactId    String    @unique
  assignedTo      String?   // GHL user ID
  firstName       String?
  lastName        String?
  phone           String?
  email           String?
  company         String?
  tags            String[]
  customFields    Json?
  createdAt       DateTime  @default(now())
  lastActivityAt  DateTime?
  ghlCreatedAt    DateTime?
  syncedAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  repStates RepContactState[]

  @@index([assignedTo])
  @@index([phone])
  @@index([email])
  @@index([tags])
  @@index([createdAt])
  @@index([lastActivityAt])
}

// Rep-specific contact state (disposition, notes, etc.)
model RepContactState {
  id                 String      @id @default(cuid())
  userId             String
  contactId          String
  disposition        Disposition @default(NOT_CALLED)
  note               String?     @db.Text
  callbackAt         DateTime?
  excludedFromExport Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([userId, contactId])
  @@index([disposition])
  @@index([callbackAt])
}

enum Disposition {
  NOT_CALLED
  CALLED
  NO_ANSWER
  LEFT_VOICEMAIL
  SPOKE_WITH
  BAD_NUMBER
  FOLLOW_UP
  NOT_INTERESTED
  CONVERTED
  DNC
}

// Saved search filters
model SavedSearch {
  id         String   @id @default(cuid())
  userId     String
  name       String
  filterJson Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Export job tracking
model ExportJob {
  id          String       @id @default(cuid())
  userId      String
  status      ExportStatus @default(PENDING)
  filterJson  Json
  totalCount  Int          @default(0)
  fileName    String?
  fileUrl     String?
  error       String?
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([status])
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Sync job tracking
model SyncJob {
  id            String     @id @default(cuid())
  ghlLocationId String
  ghlUserId     String?
  status        SyncStatus @default(PENDING)
  contactsFound Int        @default(0)
  contactsSynced Int       @default(0)
  error         String?
  startedAt     DateTime   @default(now())
  completedAt   DateTime?

  @@index([ghlLocationId])
  @@index([status])
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}
